diff --git a/internal/substrate/code_profile.go b/internal/substrate/code_profile.go
new file mode 100644
index 0000000..f1b3981
--- /dev/null
+++ b/internal/substrate/code_profile.go
@@ -0,0 +1,40 @@
+package substrate
+
+import (
+	"errors"
+	pb "github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	"os"
+	"regexp"
+	"slices"
+)
+
+const CodeAtespace = "ax-code"
+
+var codeImagePattern = regexp.MustCompile(`^[a-zA-Z0-9][a-zA-Z0-9./:_-]*@sha256:[a-f0-9]{64}$`)
+
+func CodeImage() string { return os.Getenv("AX_CODE_IMAGE") }
+func ValidateCodeTask(atespace, image string) error {
+	if atespace != CodeAtespace && (CodeImage() == "" || image != CodeImage()) {
+		return nil
+	}
+	if atespace != CodeAtespace || !codeImagePattern.MatchString(CodeImage()) || image != CodeImage() {
+		return errors.New("code_profile_rejected")
+	}
+	return nil
+}
+func applyCodeProfile(t *pb.ActorTemplate) {
+	if t.GetMetadata().GetAtespace() != CodeAtespace {
+		return
+	}
+	t.Containers[0].Command = []string{"/usr/local/bin/ax-task-runner", "--task-file", "/opt/ax-code/server-task.json"}
+	t.Containers[0].SecurityContext = &pb.SecurityContext{Capabilities: &pb.Capabilities{Drop: []string{"ALL"}, Add: []string{"KILL", "SYS_CHROOT", "SETUID", "SETGID", "SETPCAP"}}}
+	t.Resources = &pb.Resources{Limits: []*pb.Limits{{Name: "cpu", Quantity: "1"}, {Name: "memory", Quantity: "384Mi"}}}
+	t.SnapshotsConfig.OnResume.FromData = pb.ResumeSource_RESUME_SOURCE_COLD_BOOT
+}
+
+func ValidateCodeCommand(atespace string, command []string, debug bool) error {
+	if atespace == CodeAtespace && (!debug || !slices.Equal(command, []string{"python3", "/opt/ax-code/runner.py", "wait"})) {
+		return errors.New("code_command_rejected")
+	}
+	return nil
+}
