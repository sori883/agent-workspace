+func (c *Client) CreateActorWithoutRecovery(ctx context.Context, atespace, actorName, templateAtespace, templateName string) error {
+ _, err := c.control.CreateActor(ctx, &ateapipb.CreateActorRequest{Actor: &ateapipb.Actor{
+  Metadata: &ateapipb.ResourceMetadata{Name: actorName, Atespace: atespace},
+  ActorTemplate: &ateapipb.ObjectRef{Atespace: templateAtespace, Name: templateName},
+ }})
+ return err
