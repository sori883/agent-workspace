diff --git a/internal/codeprofile/profile.go b/internal/codeprofile/profile.go
new file mode 100644
index 0000000..0903821
--- /dev/null
+++ b/internal/codeprofile/profile.go
@@ -0,0 +1,100 @@
+package codeprofile
+
+import (
+	"errors"
+	pb "github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	"github.com/google/uuid"
+	"google.golang.org/protobuf/proto"
+	"regexp"
+	"strings"
+)
+
+const Atespace = "ax-code"
+const Version = "host-quota-8m-v1"
+
+var ImageReference string
+var imagePattern = regexp.MustCompile(`^[a-zA-Z0-9][a-zA-Z0-9./:_-]*@sha256:[a-f0-9]{64}$`)
+var ErrProfile = errors.New("code_profile_rejected")
+
+func Configured() bool { return imagePattern.MatchString(ImageReference) }
+func Digest() string {
+	if !Configured() {
+		return ""
+	}
+	return strings.Split(ImageReference, "@")[1]
+}
+func IsImage(ref string) bool { return Configured() && ref == ImageReference }
+func IsTemplate(t *pb.ActorTemplate) bool {
+	if t.GetMetadata().GetAtespace() == Atespace {
+		return true
+	}
+	for _, c := range t.GetContainers() {
+		if IsImage(c.GetImage()) {
+			return true
+		}
+	}
+	return false
+}
+func ValidateTemplate(t *pb.ActorTemplate) error {
+	if !IsTemplate(t) {
+		return nil
+	}
+	if !Configured() || t.GetMetadata().GetAtespace() != Atespace || len(t.GetContainers()) != 1 {
+		return ErrProfile
+	}
+	c := t.GetContainers()[0]
+	expected := &pb.Container{Name: "guest", Image: ImageReference, Command: []string{"/usr/local/bin/ax-task-runner", "--task-file", "/opt/ax-code/server-task.json"},
+		Readyz:          &pb.ContainerReadyz{HttpGet: &pb.HTTPGetAction{Path: "/readyz", Port: 80}, TimeoutSeconds: 30},
+		VolumeMounts:    []*pb.VolumeMount{{Name: "workspace", MountPath: "/workspace"}},
+		SecurityContext: &pb.SecurityContext{Capabilities: &pb.Capabilities{Drop: []string{"ALL"}, Add: []string{"KILL", "SYS_CHROOT", "SETUID", "SETGID", "SETPCAP"}}}}
+	if !proto.Equal(c, expected) || len(t.GetVolumes()) != 1 || !proto.Equal(t.Volumes[0], &pb.Volume{Name: "workspace", DurableDir: &pb.DurableDirVolumeSource{}}) {
+		return ErrProfile
+	}
+	if !proto.Equal(t.GetResources(), &pb.Resources{Limits: []*pb.Limits{{Name: "cpu", Quantity: "1"}, {Name: "memory", Quantity: "384Mi"}}}) {
+		return ErrProfile
+	}
+	if t.GetSandboxConfig().GetSandboxClass() != pb.SandboxClass_SANDBOX_CLASS_GVISOR || t.GetSandboxConfig().GetConfigName() != "gvisor-default" {
+		return ErrProfile
+	}
+	cfg := t.GetSnapshotsConfig()
+	if cfg.GetOnPause() != pb.SnapshotContentScope_SNAPSHOT_CONTENT_SCOPE_DATA || cfg.GetOnCommit() != pb.SnapshotContentScope_SNAPSHOT_CONTENT_SCOPE_DATA || cfg.GetOnResume().GetFromData() != pb.ResumeSource_RESUME_SOURCE_COLD_BOOT {
+		return ErrProfile
+	}
+	return nil
+}
+func CheckCreate(t *pb.ActorTemplate, actor *pb.Actor) error {
+	if !IsTemplate(t) {
+		return nil
+	}
+	if err := ValidateTemplate(t); err != nil {
+		return err
+	}
+	if actor.GetMetadata().GetAtespace() != Atespace || actor.GetSourceTag() != nil {
+		return ErrProfile
+	}
+	return nil
+}
+func CheckResume(t *pb.ActorTemplate, actor *pb.Actor) error {
+	if !IsTemplate(t) {
+		return nil
+	}
+	if err := CheckCreate(t, actor); err != nil {
+		return err
+	}
+	st := actor.GetStatus()
+	if st.GetCurrentActorTemplateUid() != "" || st.GetExternalSnapshot() != nil || st.GetLocalSnapshotInfo() != nil {
+		return ErrProfile
+	}
+	return nil
+}
+
+func ValidateCleanup(p *pb.CodeCleanup, actor, worker string) error {
+	if p == nil || !Configured() || p.ActorUid != actor || p.WorkerUid != worker || !p.Cleaned || p.ImageDigest != Digest() || p.Profile != Version || len(p.ProtoReflect().GetUnknown()) != 0 {
+		return ErrProfile
+	}
+	parsed, e := uuid.Parse(p.Generation)
+	if e != nil || parsed.String() != p.Generation {
+		return ErrProfile
+	}
+	return nil
+}
diff --git a/internal/codequota/mount_linux.go b/internal/codequota/mount_linux.go
new file mode 100644
index 0000000..8cad0b1
--- /dev/null
+++ b/internal/codequota/mount_linux.go
@@ -0,0 +1,317 @@
+package codequota
+
+import (
+	"bufio"
+	"errors"
+	"fmt"
+	"github.com/agent-substrate/substrate/internal/codeprofile"
+	"github.com/agent-substrate/substrate/internal/imagecache"
+	"github.com/agent-substrate/substrate/internal/ocispec"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+	"golang.org/x/sys/unix"
+	"os"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+)
+
+type Quota struct {
+	Name, Destination string
+	Bytes, Inodes     uint64
+	UID, GID          uint32
+	Mode              uint32
+}
+
+var Quotas = []Quota{
+	{"input", "/sandbox/input", 8388608 + 16384, 16, 0, 0, 0755},
+	{"tmp", "/sandbox/tmp", 8388608, 128, 65532, 65532, 0700},
+	{"output", "/sandbox/output", 8388608 + 12288, 32, 65532, 65532, 0700},
+	{"state", "/var/lib/ax-code", 262144, 32, 0, 0, 0700},
+}
+var Caps = []string{"CAP_KILL", "CAP_SETGID", "CAP_SETPCAP", "CAP_SETUID", "CAP_SYS_CHROOT"}
+
+var mountFS = unix.Mount
+var unmountFS = unix.Unmount
+var inspectMount = VerifyMount
+var listMounts = Mounts
+
+const flags = unix.MS_NOSUID | unix.MS_NODEV | unix.MS_NOEXEC
+
+func source(bundle string, q Quota) string { return filepath.Join(bundle, "code-quota", q.Name) }
+func verifySpec(spec *specs.Spec) error {
+	if spec.Process == nil || spec.Root == nil || spec.Linux == nil || spec.Process.User.UID != 0 || spec.Process.User.GID != 0 || len(spec.Process.User.AdditionalGids) > 0 || !slices.Equal(spec.Process.Args, []string{"/usr/local/bin/ax-task-runner", "--task-file", "/opt/ax-code/server-task.json"}) {
+		return ErrHold
+	}
+	c := spec.Process.Capabilities
+	if c == nil || len(c.Ambient) != 0 || len(c.Inheritable) != 0 {
+		return ErrHold
+	}
+	for _, set := range [][]string{c.Bounding, c.Effective, c.Permitted} {
+		v := slices.Clone(set)
+		slices.Sort(v)
+		if !slices.Equal(v, Caps) {
+			return ErrHold
+		}
+	}
+	for _, env := range spec.Process.Env {
+		k, _, _ := strings.Cut(env, "=")
+		if k != "PATH" && k != "LANG" && k != "GPG_KEY" && k != "PYTHON_VERSION" && k != "PYTHON_SHA256" && k != "LD_LIBRARY_PATH" && k != "SSL_CERT_FILE" && k != "SSL_CERT_DIR" && k != "REQUESTS_CA_BUNDLE" {
+			return ErrHold
+		}
+	}
+	return nil
+}
+func ValidateImage(bundle string) error {
+	overlay, e := imagecache.ReadSpec(bundle)
+	if e != nil || overlay == nil || !codeprofile.Configured() || overlay.ImageDigest != codeprofile.Digest() || len(overlay.ImageVolumes) != 0 {
+		return ErrHold
+	}
+	return nil
+}
+func ValidateBundle(bundle string) error {
+	if e := ValidateImage(bundle); e != nil {
+		return e
+	}
+	spec, e := ocispec.Load(bundle)
+	if e != nil {
+		return e
+	}
+	if e = verifySpec(spec); e != nil {
+		return e
+	}
+	if len(spec.Mounts) != 4 {
+		return ErrHold
+	}
+	seen := map[string]bool{}
+	for _, m := range spec.Mounts {
+		if seen[m.Destination] {
+			return ErrHold
+		}
+		seen[m.Destination] = true
+		if m.Destination != "/proc" && m.Destination != "/dev" && m.Destination != "/sys" && m.Destination != "/workspace" {
+			return ErrHold
+		}
+	}
+	return nil
+}
+func Prepare(bundle string) error {
+	if e := ValidateBundle(bundle); e != nil {
+		return e
+	}
+	if e := safeDir(bundle); e != nil {
+		return e
+	}
+	dir := filepath.Join(bundle, "code-quota")
+	if e := os.Mkdir(dir, 0700); e != nil {
+		return e
+	}
+	if e := safeDir(dir); e != nil {
+		return e
+	}
+	for _, q := range Quotas {
+		p := source(bundle, q)
+		if e := os.Mkdir(p, 0700); e != nil {
+			return e
+		}
+		opts := fmt.Sprintf("size=%d,nr_inodes=%d,uid=%d,gid=%d,mode=%o", q.Bytes, q.Inodes, q.UID, q.GID, q.Mode)
+		if e := mountFS("tmpfs", p, "tmpfs", flags, opts); e != nil {
+			return e
+		}
+		if e := inspectMount(p, q, true); e != nil {
+			return e
+		}
+	}
+	spec, e := ocispec.Load(bundle)
+	if e != nil {
+		return e
+	}
+	spec.Root.Readonly = true
+	spec.Process.NoNewPrivileges = true
+	pids := int64(64)
+	spec.Linux.Resources = &specs.LinuxResources{Pids: &specs.LinuxPids{Limit: &pids}}
+	for _, q := range Quotas {
+		spec.Mounts = append(spec.Mounts, specs.Mount{Destination: q.Destination, Type: "bind", Source: source(bundle, q), Options: []string{"bind", "rw", "nosuid", "nodev", "noexec"}})
+	}
+	return ocispec.Save(bundle, spec)
+}
+
+type Mount struct {
+	Path, Type string
+	Options    []string
+}
+
+func Mounts() ([]Mount, error) {
+	f, e := os.Open("/proc/self/mountinfo")
+	if e != nil {
+		return nil, e
+	}
+	defer f.Close()
+	scan := bufio.NewScanner(f)
+	scan.Buffer(make([]byte, 4096), 1048576)
+	var ms []Mount
+	for scan.Scan() {
+		fields := strings.Fields(scan.Text())
+		i := slices.Index(fields, "-")
+		if len(fields) < 7 || i < 6 || i+3 > len(fields) {
+			return nil, ErrHold
+		}
+		p := strings.NewReplacer(`\040`, " ", `\011`, "\t", `\012`, "\n", `\134`, `\`).Replace(fields[4])
+		ms = append(ms, Mount{p, fields[i+1], strings.Split(fields[5], ",")})
+	}
+	return ms, scan.Err()
+}
+func VerifyMount(p string, q Quota, empty bool) error {
+	var st unix.Stat_t
+	if e := unix.Lstat(p, &st); e != nil {
+		return e
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFDIR || st.Uid != q.UID || st.Gid != q.GID || st.Mode&07777 != q.Mode {
+		return ErrHold
+	}
+	var fs unix.Statfs_t
+	if e := unix.Statfs(p, &fs); e != nil {
+		return e
+	}
+	if uint64(fs.Bsize)*fs.Blocks != q.Bytes || fs.Files != q.Inodes || fs.Type != unix.TMPFS_MAGIC {
+		return ErrHold
+	}
+	ms, e := listMounts()
+	if e != nil {
+		return e
+	}
+	count := 0
+	for _, m := range ms {
+		if m.Path == p {
+			count++
+			if m.Type != "tmpfs" {
+				return ErrHold
+			}
+			for _, opt := range []string{"nosuid", "nodev", "noexec"} {
+				if !slices.Contains(m.Options, opt) {
+					return ErrHold
+				}
+			}
+		}
+	}
+	if count != 1 {
+		return ErrHold
+	}
+	if empty {
+		entries, e := os.ReadDir(p)
+		if e != nil {
+			return e
+		}
+		if len(entries) != 0 {
+			return ErrHold
+		}
+	}
+	return nil
+}
+func VerifyShaped(bundle string, spec *specs.Spec) error {
+	if e := verifySpec(spec); e != nil {
+		return e
+	}
+	if !spec.Root.Readonly || !spec.Process.NoNewPrivileges || spec.Linux.Resources == nil || spec.Linux.Resources.Pids == nil || spec.Linux.Resources.Pids.Limit == nil || *spec.Linux.Resources.Pids.Limit != 64 {
+		return ErrHold
+	}
+	for _, q := range Quotas {
+		count := 0
+		for _, m := range spec.Mounts {
+			if m.Destination == q.Destination {
+				count++
+				if m.Source != source(bundle, q) || m.Type != "bind" || !slices.Equal(m.Options, []string{"bind", "rw", "nosuid", "nodev", "noexec"}) {
+					return ErrHold
+				}
+			}
+		}
+		if count != 1 {
+			return ErrHold
+		}
+		if e := inspectMount(source(bundle, q), q, false); e != nil {
+			return e
+		}
+	}
+	return nil
+}
+func Remove(bundle string) error {
+	for _, q := range slices.Backward(Quotas) {
+		p := source(bundle, q)
+		ms, e := listMounts()
+		if e != nil {
+			return e
+		}
+		found := false
+		for _, m := range ms {
+			if m.Path == p {
+				found = true
+			}
+		}
+		if found {
+			if e := inspectMount(p, q, false); e != nil {
+				return e
+			}
+			if e := unmountFS(p, 0); e != nil {
+				return e
+			}
+		}
+		ms, e = listMounts()
+		if e != nil {
+			return e
+		}
+		for _, m := range ms {
+			if m.Path == p || strings.HasPrefix(m.Path, p+"/") {
+				return ErrHold
+			}
+		}
+	}
+	return nil
+}
+func UnmountBundle(bundle string) error {
+	ms, e := listMounts()
+	if e != nil {
+		return e
+	}
+	slices.SortFunc(ms, func(a, b Mount) int { return len(b.Path) - len(a.Path) })
+	for _, m := range ms {
+		if strings.HasPrefix(m.Path, bundle+"/") {
+			if e := unmountFS(m.Path, 0); e != nil {
+				return e
+			}
+		}
+	}
+	return VerifyUnmounted(bundle)
+}
+func VerifyUnmounted(bundle string) error {
+	ms, e := listMounts()
+	if e != nil {
+		return e
+	}
+	for _, m := range ms {
+		if m.Path == bundle || strings.HasPrefix(m.Path, bundle+"/") {
+			return ErrHold
+		}
+	}
+	return nil
+}
+func NoRuntimeProcesses(runscPath string) error {
+	if !filepath.IsAbs(runscPath) || os.Getpid() != 1 {
+		return ErrHold
+	}
+	entries, e := os.ReadDir("/proc")
+	if e != nil {
+		return e
+	}
+	for _, entry := range entries {
+		pid, e := strconv.Atoi(entry.Name())
+		if e != nil || pid == os.Getpid() {
+			continue
+		}
+		_, e = os.Readlink(filepath.Join("/proc", entry.Name(), "exe"))
+		if errors.Is(e, os.ErrNotExist) {
+			continue
+		}
+		return ErrHold
+	}
+	return nil
+}
diff --git a/internal/codequota/record.go b/internal/codequota/record.go
new file mode 100644
index 0000000..5244de6
--- /dev/null
+++ b/internal/codequota/record.go
@@ -0,0 +1,318 @@
+package codequota
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"github.com/google/uuid"
+	"golang.org/x/sys/unix"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+)
+
+var ErrHold = errors.New("code_quota_worker_hold")
+var idPattern = regexp.MustCompile(`^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$`)
+
+const Profile = "host-quota-8m-v1"
+
+type Record struct {
+	Version    int    `json:"version"`
+	Actor      string `json:"actor"`
+	Worker     string `json:"worker"`
+	Generation string `json:"generation"`
+	Image      string `json:"image"`
+	Profile    string `json:"profile"`
+	Bundle     string `json:"bundle"`
+}
+type Store struct{ Root string }
+type Worker struct {
+	Store          Store
+	ID, Generation string
+	lock           *os.File
+}
+
+func safeDir(p string) error {
+	fi, e := os.Lstat(p)
+	if e != nil {
+		return e
+	}
+	var st unix.Stat_t
+	se := unix.Lstat(p, &st)
+	if !fi.IsDir() || fi.Mode()&os.ModeSymlink != 0 || fi.Mode().Perm()&0022 != 0 || se != nil || int(st.Uid) != os.Geteuid() {
+		return ErrHold
+	}
+	return nil
+}
+func syncDir(p string) error {
+	f, e := os.Open(p)
+	if e != nil {
+		return e
+	}
+	defer f.Close()
+	return f.Sync()
+}
+func (s Store) init() error {
+	if !filepath.IsAbs(s.Root) {
+		return ErrHold
+	}
+	if e := os.Mkdir(s.Root, 0700); e != nil && !os.IsExist(e) {
+		return e
+	}
+	return safeDir(s.Root)
+}
+func openLock(path string, create bool) (*os.File, error) {
+	flags := unix.O_RDWR | unix.O_CLOEXEC | unix.O_NOFOLLOW
+	if create {
+		flags |= unix.O_CREAT
+	}
+	fd, e := unix.Open(path, flags, 0600)
+	if e != nil {
+		return nil, e
+	}
+	f := os.NewFile(uintptr(fd), path)
+	var st unix.Stat_t
+	if e = unix.Fstat(fd, &st); e != nil || st.Mode&unix.S_IFMT != unix.S_IFREG || (st.Nlink != 1 && st.Nlink != 2) || int(st.Uid) != os.Geteuid() || st.Mode&0077 != 0 {
+		f.Close()
+		return nil, ErrHold
+	}
+	return f, nil
+}
+func (s Store) records() ([]Record, error) {
+	if _, e := os.Lstat(s.Root); os.IsNotExist(e) {
+		return nil, nil
+	}
+	if e := safeDir(s.Root); e != nil {
+		return nil, e
+	}
+	entries, e := os.ReadDir(s.Root)
+	if e != nil {
+		return nil, e
+	}
+	var out []Record
+	for _, entry := range entries {
+		if !strings.HasSuffix(entry.Name(), ".pending") {
+			continue
+		}
+		f, e := openLock(filepath.Join(s.Root, entry.Name()), false)
+		if e != nil {
+			return nil, ErrHold
+		}
+		var r Record
+		d := json.NewDecoder(io.LimitReader(f, 4097))
+		d.DisallowUnknownFields()
+		e = d.Decode(&r)
+		var extra any
+		end := d.Decode(&extra)
+		f.Close()
+		if e != nil || end != io.EOF || r.Version != 1 || r.Profile != Profile || !idPattern.MatchString(r.Actor) || !idPattern.MatchString(r.Worker) || r.Generation == "" || entry.Name() != r.Actor+".pending" {
+			return nil, ErrHold
+		}
+		out = append(out, r)
+	}
+	return out, nil
+}
+func (s Store) GuardNode() error {
+	rs, e := s.records()
+	if e != nil {
+		return e
+	}
+	for _, r := range rs {
+		f, e := openLock(filepath.Join(s.Root, r.Worker+".lock"), false)
+		if e != nil {
+			return ErrHold
+		}
+		e = unix.Flock(int(f.Fd()), unix.LOCK_EX|unix.LOCK_NB)
+		if e == nil {
+			unix.Flock(int(f.Fd()), unix.LOCK_UN)
+			f.Close()
+			return ErrHold
+		}
+		f.Close()
+		if !errors.Is(e, unix.EWOULDBLOCK) && !errors.Is(e, unix.EAGAIN) {
+			return ErrHold
+		}
+	}
+	return nil
+}
+func (s Store) GuardActor(actor string) error {
+	if !idPattern.MatchString(actor) {
+		return ErrHold
+	}
+	rs, e := s.records()
+	if e != nil {
+		return e
+	}
+	for _, r := range rs {
+		if r.Actor == actor {
+			return ErrHold
+		}
+	}
+	return nil
+}
+func (s Store) GuardWorker(worker string) error {
+	if !idPattern.MatchString(worker) {
+		return ErrHold
+	}
+	if e := s.GuardNode(); e != nil {
+		return e
+	}
+	rs, e := s.records()
+	if e != nil {
+		return e
+	}
+	for _, r := range rs {
+		if r.Worker == worker {
+			return ErrHold
+		}
+	}
+	return nil
+}
+func (s Store) LockActor(actor string) (func(), error) {
+	if !idPattern.MatchString(actor) {
+		return nil, ErrHold
+	}
+	if e := s.init(); e != nil {
+		return nil, e
+	}
+	f, e := openLock(filepath.Join(s.Root, actor+".actor-lock"), true)
+	if e != nil {
+		return nil, e
+	}
+	if e = unix.Flock(int(f.Fd()), unix.LOCK_EX|unix.LOCK_NB); e != nil {
+		f.Close()
+		return nil, ErrHold
+	}
+	return func() { f.Close() }, nil
+}
+func (s Store) OpenWorker(id string) (*Worker, error) {
+	if !idPattern.MatchString(id) {
+		return nil, ErrHold
+	}
+	if e := s.init(); e != nil {
+		return nil, e
+	}
+	f, e := openLock(filepath.Join(s.Root, id+".lock"), true)
+	if e != nil {
+		return nil, e
+	}
+	if e = unix.Flock(int(f.Fd()), unix.LOCK_EX|unix.LOCK_NB); e != nil {
+		f.Close()
+		return nil, ErrHold
+	}
+	if e = s.GuardWorker(id); e != nil {
+		f.Close()
+		return nil, e
+	}
+	return &Worker{Store: s, ID: id, Generation: uuid.NewString(), lock: f}, nil
+}
+func (w *Worker) Close() error { return w.lock.Close() }
+func (w *Worker) Guard() error { return w.Store.GuardWorker(w.ID) }
+func (s Store) IsSpent(actor string) bool {
+	_, e := os.Lstat(filepath.Join(s.Root, actor+".done"))
+	return e == nil || !os.IsNotExist(e)
+}
+func (w *Worker) Begin(actor, image, bundle string) (*Record, error) {
+	if e := w.Guard(); e != nil {
+		return nil, e
+	}
+	if !idPattern.MatchString(actor) || w.Store.IsSpent(actor) {
+		return nil, ErrHold
+	}
+	r := &Record{Version: 1, Actor: actor, Worker: w.ID, Generation: w.Generation, Image: image, Profile: Profile, Bundle: bundle}
+	data, e := json.Marshal(r)
+	if e != nil {
+		return nil, e
+	}
+	if e = publish(w.Store.Root, actor+".pending", data); e != nil {
+		return nil, e
+	}
+	return r, nil
+}
+func publish(dir, name string, b []byte) error {
+	f, e := os.CreateTemp(dir, ".publish-")
+	if e != nil {
+		return e
+	}
+	tmp := f.Name()
+	defer os.Remove(tmp)
+	if e = f.Chmod(0600); e == nil {
+		_, e = f.Write(b)
+	}
+	if e == nil {
+		e = f.Sync()
+	}
+	ce := f.Close()
+	if e == nil {
+		e = ce
+	}
+	if e != nil {
+		return e
+	}
+	if e = os.Link(tmp, filepath.Join(dir, name)); e != nil {
+		return e
+	}
+	if e = os.Remove(tmp); e != nil {
+		return e
+	}
+	return syncDir(dir)
+}
+func (w *Worker) Current(actor string) (*Record, error) {
+	rs, e := w.Store.records()
+	if e != nil {
+		return nil, e
+	}
+	for _, r := range rs {
+		if r.Actor == actor {
+			if r.Worker != w.ID || r.Generation != w.Generation {
+				return nil, ErrHold
+			}
+			return &r, nil
+		}
+	}
+	return nil, ErrHold
+}
+func (w *Worker) Complete(r *Record) error {
+	current, e := w.Current(r.Actor)
+	if e != nil || *current != *r {
+		return ErrHold
+	}
+	b, e := json.Marshal(r)
+	if e != nil {
+		return e
+	}
+	if e = publish(w.Store.Root, r.Actor+".done", b); e != nil {
+		return e
+	}
+	if e = os.Remove(filepath.Join(w.Store.Root, r.Actor+".pending")); e != nil {
+		return e
+	}
+	return syncDir(w.Store.Root)
+}
+func (s Store) String() string { return fmt.Sprintf("code quota store %s", s.Root) }
+
+func (w *Worker) Completed(actor string) (*Record, error) {
+	if !idPattern.MatchString(actor) {
+		return nil, ErrHold
+	}
+	if err := w.Store.GuardActor(actor); err != nil {
+		return nil, err
+	}
+	f, e := openLock(filepath.Join(w.Store.Root, actor+".done"), false)
+	if e != nil {
+		return nil, ErrHold
+	}
+	defer f.Close()
+	var r Record
+	d := json.NewDecoder(io.LimitReader(f, 4097))
+	d.DisallowUnknownFields()
+	e = d.Decode(&r)
+	var extra any
+	end := d.Decode(&extra)
+	if e != nil || end != io.EOF || r.Version != 1 || r.Actor != actor || r.Worker != w.ID || r.Generation != w.Generation || r.Profile != Profile {
+		return nil, ErrHold
+	}
+	return &r, nil
+}
