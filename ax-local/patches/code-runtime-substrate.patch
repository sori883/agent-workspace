new file mode 100644
index 0000000..1a04bed
--- /dev/null
+++ b/cmd/ateom-gvisor/code_runtime.go
@@ -0,0 +1,158 @@
+//go:build linux
+
+package main
+
+import (
+	"context"
+	"errors"
+	"github.com/agent-substrate/substrate/internal/ateomnet"
+	"github.com/agent-substrate/substrate/internal/ateompath"
+	"github.com/agent-substrate/substrate/internal/codeprofile"
+	"github.com/agent-substrate/substrate/internal/codequota"
+	"github.com/agent-substrate/substrate/internal/imagecache"
+	"github.com/agent-substrate/substrate/internal/ocispec"
+	"github.com/agent-substrate/substrate/internal/proto/ateompb"
+	"github.com/agent-substrate/substrate/internal/resources"
+	pb "github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	"path/filepath"
+	"slices"
+)
+
+func quotaStore() codequota.Store {
+	return codequota.Store{Root: filepath.Join(ateompath.BasePath, "code-quota")}
+}
+func (s *AteomService) beginCode(req *ateompb.RunWorkloadRequest) (bool, error) {
+	if s.codeWorker != nil {
+		if e := s.codeWorker.Guard(); e != nil {
+			return false, e
+		}
+	}
+	code := req.GetAtespace() == codeprofile.Atespace
+	if !code {
+		for _, c := range req.GetSpec().GetContainers() {
+			sp, e := imagecache.ReadSpec(ateompath.OCIBundlePath(req.GetActorUid(), c.GetName()))
+			if e == nil && sp != nil && codeprofile.Configured() && sp.ImageDigest == codeprofile.Digest() {
+				return false, codeprofile.ErrProfile
+			}
+		}
+		return false, nil
+	}
+	if s.codeWorker == nil || !codeprofile.Configured() || req.GetRunscPath() != filepath.Join(ateompath.StaticFilesDir, "gvisor-a64916f9813ce7e4841a30480a599337f7dda07b421c6bf0123db2212aa7d1df", "runsc") || req.GetCpuMilli() != 1000 || req.GetMemoryBytes() != 384*1024*1024 || len(req.GetSpec().GetContainers()) != 1 || req.Spec.Containers[0].GetName() != "guest" {
+		return false, codeprofile.ErrProfile
+	}
+	bundle := ateompath.OCIBundlePath(req.GetActorUid(), "guest")
+	if e := codequota.ValidateImage(bundle); e != nil {
+		return false, e
+	}
+	if _, e := s.codeWorker.Begin(req.GetActorUid(), codeprofile.Digest(), bundle); e != nil {
+		return false, e
+	}
+	return true, codequota.ValidateBundle(bundle)
+}
+func (s *AteomService) stopCode(ctx context.Context, actorRef resources.ActorRef, actorUID, runscPath string, containers []*ateompb.Container) error {
+	if s.codeWorker == nil {
+		return codequota.ErrHold
+	}
+	rec, e := s.codeWorker.Current(actorUID)
+	completed := false
+	if e != nil {
+		rec, e = s.codeWorker.Completed(actorUID)
+		if e != nil {
+			return e
+		}
+		completed = true
+	}
+	if rec.Bundle != ateompath.OCIBundlePath(actorUID, "guest") || rec.Image != codeprofile.Digest() {
+		return codequota.ErrHold
+	}
+	r := &runsc{path: runscPath, actorUID: actorUID}
+	if completed {
+		return observeCodeCleanup(ctx, r,
+			func() error { return codequota.NoRuntimeProcesses(runscPath) },
+			func() error { return codequota.VerifyUnmounted(ateompath.OCIBundleDir(actorUID)) })
+	}
+	if e := s.deactivateActorNetworking(ctx); e != nil {
+		return e
+	}
+
+	return finishCodeCleanup(ctx, r,
+		func() error { return codequota.NoRuntimeProcesses(runscPath) },
+		func() error {
+			if e := codequota.Remove(rec.Bundle); e != nil {
+				return e
+			}
+			return codequota.UnmountBundle(ateompath.OCIBundleDir(actorUID))
+		},
+		func() error {
+			if e := ateomnet.CleanupActorNetwork(ctx, s.interiorNetNS); e != nil {
+				return e
+			}
+			return s.codeWorker.Complete(rec)
+		})
+}
+func finishCodeCleanup(ctx context.Context, r containerRuntime, verify, unmount, complete func() error) error {
+	ids, e := r.cmdList(ctx)
+	if e != nil {
+		return e
+	}
+	for _, id := range ids {
+		if id != "guest" && id != ocispec.PauseContainer {
+			return codequota.ErrHold
+		}
+	}
+	for _, id := range []string{"guest", ocispec.PauseContainer} {
+		if slices.Contains(ids, id) {
+			if e := r.cmdDelete(ctx, id); e != nil {
+				return e
+			}
+		}
+	}
+	ids, e = r.cmdList(ctx)
+	if e != nil || len(ids) != 0 {
+		return codequota.ErrHold
+	}
+	if e := verify(); e != nil {
+		return e
+	}
+	if e := unmount(); e != nil {
+		return e
+	}
+	if e := complete(); e != nil {
+		return e
+	}
+
+	return nil
+}
+func (s *AteomService) hasCode(actor string) bool {
+	if s.codeWorker == nil {
+		return false
+	}
+	return s.codeWorker.Store.GuardActor(actor) != nil
+}
+func codeTerminationError(err error) error { return errors.Join(codequota.ErrHold, err) }
+
+func (s *AteomService) completedCode(actor string) (*pb.CodeCleanup, error) {
+	if s.codeWorker == nil {
+		return nil, codequota.ErrHold
+	}
+	r, e := s.codeWorker.Completed(actor)
+	if e != nil {
+		return nil, e
+	}
+	proof := &pb.CodeCleanup{ActorUid: r.Actor, WorkerUid: r.Worker, Generation: r.Generation, ImageDigest: r.Image, Profile: r.Profile, Cleaned: true}
+	if e = codeprofile.ValidateCleanup(proof, actor, s.codeWorker.ID); e != nil {
+		return nil, e
+	}
+	return proof, nil
+}
+
+func observeCodeCleanup(ctx context.Context, r containerRuntime, verifyProcesses, verifyMounts func() error) error {
+	ids, e := r.cmdList(ctx)
+	if e != nil || len(ids) != 0 {
+		return codequota.ErrHold
+	}
+	if e := verifyProcesses(); e != nil {
+		return e
+	}
+	return verifyMounts()
+}
