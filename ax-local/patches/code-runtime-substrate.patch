@@ -0,0 +1,30 @@
+package controlapi
+
+import (
+	"context"
+	"github.com/agent-substrate/substrate/cmd/ateapi/internal/store"
+	"github.com/agent-substrate/substrate/internal/codeprofile"
+	"github.com/agent-substrate/substrate/internal/resources"
+	pb "github.com/agent-substrate/substrate/pkg/proto/ateapipb"
+	"google.golang.org/protobuf/proto"
+)
+
+func (w *ActorWorkflow) saveCodeCleanup(ctx context.Context, actor *pb.Actor, proof *pb.CodeCleanup) error {
+	uid := actor.GetMetadata().GetUid()
+	worker := actor.GetStatus().GetWorkerAssignment().GetWorkerPodUid()
+	if err := codeprofile.ValidateCleanup(proof, uid, worker); err != nil {
+		return err
+	}
+	latest, err := w.store.GetActor(ctx, resources.ActorRefFromActor(actor))
+	if err != nil {
+		return err
+	}
+	_, err = w.store.UpdateActor(ctx, resources.ActorRefFromActor(actor), store.PreconditionFrom(latest), func(current *pb.Actor) error {
+		if current.GetMetadata().GetUid() != uid || current.GetStatus().GetWorkerAssignment().GetWorkerPodUid() != worker {
+			return codeprofile.ErrProfile
+		}
+		current.Status.CodeCleanup = proto.CloneOf(proof)
+		return nil
+	})
+	return err
+}
