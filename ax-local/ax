#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")" && pwd)"
if [[ -e "$root/.state/execution/managed" && "${AX_ADMIN_RECOVERY:-}" != "1" ]]; then
  echo "Direct AX commands are retired. Use the common API; administrative recovery requires the documented procedure." >&2
  exit 1
fi
exec bash "$root/with-env.sh" "$root/bin/ax" "$@"
